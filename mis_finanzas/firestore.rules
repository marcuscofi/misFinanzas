rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/transacciones/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.montoCentavos is int
        && request.resource.data.montoCentavos > 0
        && request.resource.data.tipo in ['ingreso', 'gasto']
        && request.resource.data.fecha is timestamp
        && request.resource.data.get('cuentaId', 'efectivo') is string
        && (request.resource.data.tipo == 'gasto'
            || request.resource.data.get('cuentaId', 'efectivo') == 'efectivo'
            || exists(/databases/$(database)/documents/users/$(uid)/cuentasBancarias/$(request.resource.data.get('cuentaId', 'efectivo'))));
    }

    match /users/{uid}/tarjetas/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.banco is string
        && request.resource.data.alias is string
        && request.resource.data.limiteMensualCentavos is int
        && request.resource.data.limiteMensualCentavos > 0
        && request.resource.data.activa is bool
        && request.resource.data.creada is timestamp;
    }

    match /users/{uid}/cuentasBancarias/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.banco is string
        && request.resource.data.alias is string
        && request.resource.data.tipo in ['cuenta', 'debito']
        && request.resource.data.activa is bool
        && request.resource.data.creada is timestamp;
    }

    match /users/{uid}/planesAhorro/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.regla in ['porcentaje', 'montoFijo']
        && request.resource.data.valor is int
        && request.resource.data.valor > 0
        && (request.resource.data.regla != 'porcentaje' || request.resource.data.valor <= 100)
        && request.resource.data.desde is timestamp;
    }
  }
}
