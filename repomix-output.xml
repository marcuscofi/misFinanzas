Color colorTarjeta(String banco) {
  const c = [
    Paleta.esmeralda, Paleta.menta, Paleta.lima,
    Color(0xFF5BC0FF), Color(0xFFB388FF), Color(0xFFFFB74D),
  ];
  final i = bancos.indexOf(banco);
  return c[(i < 0 ? 0 : i) % c.length];
}

